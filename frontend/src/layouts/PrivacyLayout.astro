---
import Layout from "./Layout.astro";

interface Props {
  title: string;
  breadcrumb?: string;
  frontmatter?: { title: string; breadcrumb?: string };
}

const { title, breadcrumb } = Astro.props.frontmatter ?? Astro.props;
---

<Layout title={title} breadcrumbs={[breadcrumb ?? title]}>
  <div class="page">
    <slot />
  </div>
</Layout>
