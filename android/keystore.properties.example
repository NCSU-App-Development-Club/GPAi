# Copy this file to android/keystore.properties and fill in real values.
# keystore.properties is gitignored and must never be committed.
#
# Generate an upload keystore with:
#   keytool -genkeypair -v \
#     -keystore keystore/gpai-upload.jks \
#     -alias gpai-upload \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile is resolved relative to the android/ project root.

storeFile=keystore/gpai-upload.jks
storePassword=CHANGE_ME
keyAlias=gpai-upload
keyPassword=CHANGE_ME
