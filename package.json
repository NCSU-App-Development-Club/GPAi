{
  "name": "gpai",
  "private": true,
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "build": "npm run build --workspace=frontend && npm run build --workspace=gpai-backend",
    "dev:backend": "npm run dev --workspace=gpai-backend",
